# Copy to .env (git-ignored, mode 600) and fill in. Only scripts that need a value get it: package.json passes the
# file to them with node's --env-file-if-exists, so nothing else loads it.

# Needed by `make popularity` (the Lichess explorer counts) and `pnpm puzzles:expand`. A free personal API token with
# no scopes: https://lichess.org/account/oauth/token
LICHESS_TOKEN=
