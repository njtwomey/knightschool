# Copy to .env (git-ignored, mode 600) and fill in. Only scripts that need a value get it: package.json
# passes the file to them with node's --env-file-if-exists, so nothing else loads it.

# Needed only by `make popularity` (pnpm popularity), the one script that asks Lichess for data. A free personal API token
# with no scopes. Create one at https://lichess.org/account/oauth/token
LICHESS_TOKEN=
