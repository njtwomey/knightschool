[Event "Knight School"]
[Opening "Vienna Game"]
[Variation "Vienna Game: Vienna Gambit, Breyer Variation, 5...Bc5"]
[ECO "C29"]
[Character "gambit,sharp"]
[Risk "medium"]
[EarlyMate "none"]
[Tricks "none"]
[Themes "centre-fight,bishop-pair"]
