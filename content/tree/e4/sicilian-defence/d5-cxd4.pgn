[Event "Knight School"]
[Opening "Sicilian Defense: Alapin Variation"]
[Variation "Alapin Variation, Barmen Defense, Central Exchange"]
[ECO "B22"]
[Character "solid,positional"]
[Risk "low"]
[EarlyMate "none"]
[Tricks "early-queen"]
[Themes "tempo-gain,transposition,d4-pawn-centre"]
[For "white"]
[Kind "sideline"]
[Opponent "4...cxd4"]
[Start "d5-main-line 4.d4"]

4... cxd4 ( 4... e6 { The same position as 2...e6 3.d4 d5 4.exd5 Qxd5, where 5.Nf3 guards d4. } ) ( 4... e5 5. dxe5 { Takes the pawn and offers the queens. With them gone, White keeps the extra pawn and the king is safe enough on d1. } 5... Qxd1+ 6. Kxd1 Nc6 7. f4 ) 5. cxd4 { Takes back with the pawn and frees c3 for the knight, which will hit the queen. } 5... Nc6 { Joins the line 2...Nc6 3.d4 cxd4 4.cxd4 d5 5.exd5 Qxd5, where White plays 6.Nf3: Be2 against ...Bg4, and Nc3 and d4-d5 against the rest. } ( 5... Nf6 6. Nf3 e6 ( 6... Nc6 { The same position as 2...Nc6 3.d4 cxd4 4.cxd4 d5 5.exd5 Qxd5 6.Nf3 Nf6, where 7.Nc3 hits the queen and d4-d5 follows. } ) ( 6... Bg4 7. Be2 { Breaks the pin, the same answer as in the other ...Bg4 lines. } ) ) ( 5... e5 6. Nf3 exd4 ( 6... Nc6 { Joins the line 2...Nc6 3.d4 d5 4.exd5 Qxd5 5.Nf3 cxd4 6.cxd4 e5, where 7.Nc3 hits the queen. } ) 7. Qxd4 ) ( 5... e6 { Joins the line 2...e6 3.d4 cxd4 4.cxd4 d5 5.exd5 Qxd5, where 6.Nf3 comes next. } ) *
