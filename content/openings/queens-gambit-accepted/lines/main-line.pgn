[Event "Knight School"]
[Opening "Queen's Gambit Accepted"]
[Variation "Classical Defence"]
[ECO "D27"]
[Character "solid,positional"]
[Risk "low"]
[EarlyMate "none"]
[Tricks "none"]
[Themes "c5-break,queenside-expansion"]

1. d4 d5 { Claims a share of the centre and stops White playing e4 for free. } 2. c4 dxc4 { Takes the pawn. Black cannot hold it for long, but White has to spend moves winning it back. }
3. Nf3 Nf6 { Develops a piece and stops e4, because ...Nxe4 would win a pawn. }
4. e3 ( 4. Nc3 a6 { Prepares ...b5, so Black can keep the pawn. } 5. e4 b5 6. e5 Nd5 { The knight comes to a good square and offers a trade of White's attacking knight. } 7. a4 Nxc3 8. bxc3 Bb7 )
4... e6 { Opens the bishop on f8 and prepares ...c5. }
5. Bxc4 c5 { The freeing move. Black strikes at d4 at once and uses the temporary pawn to get active pieces. }
6. O-O a6 { Prepares ...b5, which will kick the bishop off c4. }
7. Qe2 ( 7. a4 { Stops ...b5. } 7... Nc6 { Develops and adds a second attacker to d4, instead of ...b5. } 8. Qe2 Be7 9. Rd1 cxd4 10. exd4 O-O )
7... b5 { Drives the bishop back and gains queenside space. }
8. Bb3 Bb7 { Puts the bishop on the long diagonal, pointing at White's king side. }
9. Rd1 Nbd7 { Finishes development. The knight also covers e5 and b6. }
10. Nc3 Qb6 { Supports the pawn on c5 and prepares to take on d4. }
11. a3 Bd6 { Develops, and guards c5 so that dxc5 can be met by a recapture. }
12. dxc5 Bxc5 { Retakes with the bishop, which now looks down the diagonal at f2. } *
