[Event "Knight School"]
[Opening "Queen's Gambit"]
[Variation "Queen's Gambit Declined: Chigorin Defense, 3...e6"]
[ECO "D07"]
[Character "positional"]
[Risk "low"]
[EarlyMate "none"]
