[Event "Knight School"]
[Opening "London System"]
[Variation "Queen's Pawn Game: London System, Bd3 blunder"]
[ECO "D02"]
[Character "tactical"]
[Risk "low"]
[EarlyMate "none"]
[Tricks "trap,pawn-grab"]
[Themes "b2-pressure"]
[Refutes "1. d4 d5 2. Nf3 Nf6 3. Bf4 c5 4. e3 Nc6 5. c3 Qb6 6. Bd3"]
[For "black"]
[Kind "for-us"]
[Opponent "6.Bd3"]
[Start "london-main 5...Qb6"]

6. Bd3 $2 { Develops a piece but forgets b2. The queen on b6 is still aiming at it. } 6... c4 { Attacks the bishop. Wherever it goes, nothing guards b2, so that pawn is next. } 7. Bc2 Qxb2 { Takes the pawn and attacks both the knight on b1 and the rook on a1. } 8. Nbd2 Qxc3 { Black is two pawns up, and the queen on c3 is safe and hits the knight on d2. } *
