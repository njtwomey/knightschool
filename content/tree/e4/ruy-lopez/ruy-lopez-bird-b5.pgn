[Event "Knight School"]
[Opening "Ruy Lopez"]
[Variation "Ruy Lopez: Bird Variation, queenside pawn push"]
[ECO "C61"]
[Character "tactical"]
[Risk "low"]
[EarlyMate "none"]
[Tricks "trap,fork"]
[Themes "f7-weakness"]
[Refutes "1. e4 e5 2. Nf3 Nc6 3. Bb5 Nd4 4. Nxd4 exd4 5. O-O a6 6. Bc4 b5"]
[For "white"]
[Kind "for-us"]
[Opponent "5...a6 6.Bc4 b5"]
[Start "ruy-lopez-bird 5...a6 6.Bc4"]

6... b5 $2 { Chases the bishop and expects it to step back. } 7. Bxf7+ { The bishop sacrifices itself on f7 instead. [%cal Gc4f7] } 7... Kxf7 8. Qh5+ { Check from the side. } 8... g6 9. Qd5+ { Check again, and now the queen hits the rook on a8 too. [%cal Gd5a8] } 9... Kg7 10. Qxa8 { White has won a rook for the bishop, and Black's king is still exposed. } *
